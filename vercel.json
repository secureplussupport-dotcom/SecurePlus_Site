{
  "rewrites": [
    {
      "source": "/api/coins/action",
      "destination": "/api/economy?operation=coins-action"
    },
    {
      "source": "/api/coins/me",
      "destination": "/api/economy?operation=coins-me"
    },
    {
      "source": "/api/referrals/claim",
      "destination": "/api/economy?operation=referrals-claim"
    },
    {
      "source": "/api/referrals/me",
      "destination": "/api/economy?operation=referrals-me"
    },
    {
      "source": "/api/assistant",
      "destination": "/api/economy?operation=cipher-assistant"
    }
  ],
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    }
  ]
}
