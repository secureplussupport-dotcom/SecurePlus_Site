{
  "ignoreCommand": "node scripts/vercel-ignore-build.mjs",
  "rewrites": [
    {
      "source": "/api/coins/action",
      "destination": "/api/economy?operation=coins-action"
    },
    {
      "source": "/api/coins/me",
      "destination": "/api/economy?operation=coins-me"
    },
    {
      "source": "/api/referrals/claim",
      "destination": "/api/economy?operation=referrals-claim"
    },
    {
      "source": "/api/referrals/me",
      "destination": "/api/economy?operation=referrals-me"
    },
    {
      "source": "/api/stripe/cancel",
      "destination": "/api/stripe?operation=cancel"
    },
    {
      "source": "/api/stripe/checkout",
      "destination": "/api/stripe?operation=checkout"
    },
    {
      "source": "/api/stripe/portal",
      "destination": "/api/stripe?operation=portal"
    },
    {
      "source": "/api/stripe/sync",
      "destination": "/api/stripe?operation=sync"
    },
    {
      "source": "/api/stripe/webhook",
      "destination": "/api/stripe?operation=webhook"
    }
  ],
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    }
  ]
}
