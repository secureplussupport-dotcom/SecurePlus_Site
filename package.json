{
  "name": "secureplus-site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "android:sync": "npm run build && npx cap sync android",
    "android:open": "npx cap open android",
    "android:debug": "npm run android:sync && cd android && ./gradlew assembleDebug",
    "android:release": "npm run android:sync && cd android && ./gradlew bundleRelease",
    "audit": "npm run audit:launch && npm run audit:coins && npm run audit:engagement && npm run audit:seo && npm run audit:pwa && npm run audit:deep-dives && npm run audit:editorial && npm run audit:qbank:strict",
    "audit:editorial": "node scripts/audit-editorial.mjs",
    "audit:launch": "node scripts/audit-launch.mjs",
    "audit:coins": "node scripts/audit-cipher-welcome.mjs",
    "audit:engagement": "node scripts/audit-engagement.mjs",
    "audit:pwa": "node scripts/audit-pwa.mjs",
    "audit:seo": "node scripts/audit-seo.mjs",
    "audit:deep-dives": "node scripts/audit-deep-dives.mjs",
    "audit:qbank": "node scripts/audit-qbank.mjs",
    "audit:qbank:strict": "node scripts/audit-qbank.mjs --strict",
    "audit:learning-pilot": "node scripts/audit-learning-pilot.mjs",
    "audit:learning-persistence": "node scripts/audit-learning-persistence.mjs",
    "audit:learning-migration": "node scripts/audit-learning-migration.mjs",
    "audit:learning-database": "node scripts/audit-learning-database.mjs",
    "audit:learning-runtime": "node --test scripts/audit-learning-runtime.mjs",
    "audit:learning-boundary": "node --test scripts/audit-learning-boundary.mjs",
    "audit:learning-boundary:database": "node scripts/audit-learning-boundary-database.mjs",
    "audit:learning-deletion-shadow": "node scripts/audit-learning-deletion-shadow.mjs",
    "audit:learning-infrastructure": "node scripts/audit-learning-infrastructure.mjs",
    "audit:learning-trusted-runtime": "node scripts/audit-trusted-learning-runtime.mjs",
    "audit:learning-operations": "node --test scripts/audit-learning-operations.mjs",
    "audit:learning-operations:database": "node scripts/rehearse-learning-operations.mjs",
    "audit:learning-operations:cleanup": "node scripts/audit-learning-operations-cleanup.mjs",
    "build:content-mapping": "node scripts/build-content-mapping.mjs",
    "audit:content-mapping": "node --test scripts/audit-content-mapping.mjs && node scripts/build-content-mapping.mjs --check",
    "build:mcq-engine": "node scripts/build-mcq-engine-catalogue.mjs",
    "audit:mcq-engine": "node --test scripts/test-mcq-three-deck.mjs scripts/test-mcq-engine-http.mjs scripts/test-mcq-difficulty.mjs && node scripts/build-mcq-engine-catalogue.mjs --check",
    "audit:mcq-engine:database": "node scripts/test-mcq-engine-database.mjs",
    "prebuild": "node scripts/build-mcq-engine-catalogue.mjs --check"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.105.3",
    "lucide-react": "^0.468.0",
    "postgres": "3.4.9",
    "posthog-js": "1.395.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "stripe": "22.1.1"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@electric-sql/pglite": "0.5.10",
    "@vitejs/plugin-react": "6.0.1",
    "vite": "8.1.0"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
